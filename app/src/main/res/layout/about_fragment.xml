<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/about_fragment_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/about_fragment_version"
        android:text="@string/about"
        android:textSize="16sp"
        android:textColor="@color/spbu_primary_terracot_color"
        android:layout_margin="16dp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/about_fragment_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/about_fragment_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/about_fragment_legend_label"
        android:text="@string/application_version"
        android:layout_margin="16dp"
        />
    <TextView
        android:id="@+id/about_fragment_legend_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/about_fragment_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/leged"
        android:textColor="@color/spbu_primary_terracot_color"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_margin="16dp"/>
    <TextView
        android:id="@+id/about_fragment_legend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/about_fragment_legend_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="16sp"
        android:textAlignment="center"
        android:text=""/>





</androidx.constraintlayout.widget.ConstraintLayout>