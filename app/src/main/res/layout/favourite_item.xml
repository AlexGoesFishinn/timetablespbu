<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/favorite_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="16.Б956-фз"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/favourite_remove"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="@color/spbu_primary_terracot_color"
        android:gravity="start"/>
    <TextView
        android:id="@+id/favourite_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:text="@string/remove"
        android:textColor="@color/spbu_primary_terracot_color"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/favorite_item_text"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="end"/>



</androidx.constraintlayout.widget.ConstraintLayout>